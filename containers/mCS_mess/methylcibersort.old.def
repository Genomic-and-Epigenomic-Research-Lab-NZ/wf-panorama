Bootstrap: docker
From: rocker/r-ver:3.6.3

%post
    apt-get update && apt-get install -y fakeroot libcap2 libseccomp2
    apt-get update && apt-get install -y \
        libxml2-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        libicu-dev \
        libz-dev \
        libpng-dev \
        libblas-dev \
        liblapack-dev \
        libfftw3-dev \
        && apt-get clean

    # Install CRAN packages
    R -e "install.packages(c('quadprog','matrixStats','NMF','doParallel','glmnet','caret'), repos='https://cloud.r-project.org')"

    # Install Bioconductor packages
    R -e "if (!requireNamespace('BiocManager', quietly=TRUE)) install.packages('BiocManager')"
    R -e "BiocManager::install(c('minfi','multtest'), ask=FALSE, version='3.10')"

    # Install your local package
    # Assumes you copy it into the container build context
    R CMD INSTALL /opt/MethylCIBERSORT_0.2.0.tar.gz

%files
    /projects/uow/GERL/dejlu879/Panorama/wf-panorama/resources/MethylCIBERSORT_Release/MethylCIBERSORT_0.2.0.tar.gz /opt/MethylCIBERSORT_0.2.0.tar.gz

%environment
    export R_LIBS=/usr/local/lib/R/site-library
