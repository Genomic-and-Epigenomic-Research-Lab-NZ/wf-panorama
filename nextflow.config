//
// Notes to End Users.
//
// The workflow should run without editing this configuration file,
// however there may be instances in which you wish to edit this
// file for compute performance or other reasons. Please see:
//
//   https://nextflow.io/docs/latest/config.html#configuration
//
// for further help editing this file.


params {
    help = false
    version = false
    make_target_bed = false
    clin_trial_mode = false
    clinical_mode = false
    project_name = null
    panel_metadata = null // Path to panel metadata CSV
    sample = null
    bam_directory = null
    buffersize_bp = 10000
    min_genome_coverage = 0.5
    max_genome_coverage = 5.0
    out_dir = null
    cibersortx_username = ''
    cibersortx_token = ''
    cibersortx_permutations = 100  // default number recommended by Newman et.al.
    skip_cibersortx = false  // set to true to skip run_CIBERSORTX and use a pre-existing results file from the output directory  TODO: remove when we have token
    report_title = null  // title for the clinical report generated in clinical_mode; defaults to project_name if not set
    mCS_cancer_type = 'bladder'  // cancer type signature for MethylCIBERSORT; see nextflow_schema.json for valid options
    meth_coverage_threshold = 30  // minimum coverage for methylation calling; passed to sample_processing.nf and process_result_before_betas.py
    reference_genome = null  // reference genome identifier; defaults to resources/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna but can be overridden
    reference_genome_idx = null  // reference genome index file (e.g. .fai); defaults to resources/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna.fai but can be overridden (must correspond to reference_genome)
    chrom_sizes_file = null  // reference chrom sizes file; defaults to resources/hg38_no_alt.chrom_sizes (bundled) but can be overridden if needed
    Illumina_epic_locs = null  // reference Illumina EPIC probe genomic coordinates file; defaults to resources/IlluminaEPIC_genomic_locations_hg38.csv (bundled) but can be overridden if needed
    max_cores = 16
    target_bedfile = null  // if null, will be generated by the workflow from the panel metadata
    wf_humvar_basecaller = null
    wf_humvar_profile = 'singularity'  // container profile for nested wf-human-variation run
    wf_humvar_threads = 8
    wf_humvar_bam_min_coverage = 15  // Use 0 for testing to disable the check, but in general we want some minimum coverage threshold to avoid false positives in low-coverage regions. This is passed to wf-human-variation and can be adjusted based on the expected coverage of the samples.
    wf_humvar_trf_file = null // reference tandem repeats file; defaults to resources/hg38.trf.bed (bundled) but can be overridden if needed
    ont_basecaller = 'dna_r10.4.1_e8.2_400bps_hac@v4.1.0'  // passed to wf-human-variation to override default basecaller config (for testing with original cell line data only, will not be available in final version)
    wf_humvar_resume = true        // set to true to resume a previous wf-human-variation run
    singularity_cache = null  // set to singularity.cacheDir if using singularity profile
    r_methyl_container = null  // if null, falls back to containers/methylcibersort.sif
    max_memory = '128.GB'  // upper limit for process memory requests; prevents crashes on smaller systems
    max_cpus   = 32        // upper limit for process CPU requests
    max_time   = '240.h'   // upper limit for process time requests
    // Template params retained for compatibility (may be removed if not needed)
    sample_sheet = null
    client_fields = null
    disable_ping = false
    monochrome_logs = false
    validate_params = true
    show_hidden_params = false
    schema_ignore_params = 'show_hidden_params,validate_params,monochrome_logs,aws_queue,aws_image_prefix,wf,store_dir,sample,bam_directory,cibersortx_username,cibersortx_token'
}

// in nextflow_schema.json > definitions > input > properties: 
// watch_path is removed but maybe useful to add back in the far future
                // "watch_path": {
                //     "type": "boolean",
                //     "default": false,
                //     "description": "Enable to continuously watch the input directory for new input files.",
                //     "help_text": "This option enables the use of Nextflow\u2019s directory watching feature to constantly monitor input directories for new files."
                // },

// Set default out_dir based on project_name if not explicitly provided
if (!params.out_dir) {
    params.out_dir = "${params.project_name ?: 'demo_project'}"
}
// Set the target bed file path based on project_name if not explicitly provided
if (!params.target_bedfile) {
    params.target_bedfile = "${params.out_dir}/minknow_input/${params.project_name}.targets_for_align.bed"
}
// Set report_title to project_name if not explicitly provided
if (!params.report_title) {
    params.report_title = "${params.project_name ?: 'Report'}"
}

manifest {
    name            = 'wf-panorama'
    author          = 'Lucy Picard'
    description     = 'Panorama sample processing workflow'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.2'
    version         = 'v0.1.0'
}


// Default process settings
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}

// Note: CIBERSORTx container bind-mounts are handled in the process definition
// in sample_processing.nf, not here, because task.workDir is not available at
// config parse time.

profiles {
    // the "standard" profile is used implicitely by nextflow
    // if no other profile is given on the CLI
    standard {
        docker {
            enabled = true
            // this ensures container is run as host user and group, but
            //    also adds host user to the within-container group
            runOptions = "--user \$(id -u):\$(id -g) --group-add 100"
        }
    }

    // using singularity instead of docker
    singularity {
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache ?: "${HOME}/.nextflow/singularity"
        }
    }

    // Apptainer is the open-source fork of Singularity (common on newer HPC systems)
    apptainer {
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache ?: "${HOME}/.nextflow/apptainer"
        }
    }

    // keep stub conda profile to prevent unknown profile warning so users get a better error
    conda {
        conda.enabled = true
    }

    // local profile for simplified development testing
    local {
        process.executor = 'local'
    }

    slurm {
        process.executor         = 'slurm'
        executor.submitRateLimit = '100/1min'
    }

    lsf {
        process.executor         = 'lsf'
        executor.submitRateLimit = '100/1min'
    }

    pbs {
        process.executor         = 'pbspro'
        executor.submitRateLimit = '100/1min'
    }

    // Minimal local test profile — no HPC scheduler, no container required.
    // Useful for verifying the install and checking parameter wiring.
    test {
        process.executor = 'local'
        params {
            project_name     = 'test_project'
            sample           = 'test_sample'
            mCS_cancer_type  = 'bladder'
            skip_cibersortx  = true
            // Uncomment and point at bundled demo inputs when available:
            // bam_directory  = "${projectDir}/test_data/bams"
            // panel_metadata = "${projectDir}/test_data/panel_metadata.csv"
        }
    }
}


timeline {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/timeline.html"
}
report {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/report.html"
}
trace {
    enabled = true
    overwrite = true
    file = "${params.out_dir}/execution/trace.txt"
}

env {
    PYTHONNOUSERSITE  = 1
    JAVA_TOOL_OPTIONS = "-Xlog:disable -Xlog:all=warning:stderr"
    // NXF_SINGULARITY_CACHEDIR = "${projectDir}/containers/singularity"
    // NXF_SINGULARITY_CACHEDIR is intentionally NOT set here so that:
    //   1. Users who set it in their environment or via --singularity_cache are respected.
    //   2. The singularity/apptainer profile cacheDir (${HOME}/.nextflow/singularity) is used by default.
    // If you need a shared system-wide cache, set --singularity_cache on the CLI or export
    // NXF_SINGULARITY_CACHEDIR in your shell before running the pipeline.
}

// Resource cap helper — prevents any process from requesting more than the system has.
// Set upper limits via --max_memory, --max_cpus, --max_time on the CLI or in a profile.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def mem = obj as nextflow.util.MemoryUnit
            return mem <= (params.max_memory as nextflow.util.MemoryUnit) ? mem : (params.max_memory as nextflow.util.MemoryUnit)
        } catch (all) { return params.max_memory as nextflow.util.MemoryUnit }
    } else if (type == 'time') {
        try {
            def dur = obj as nextflow.util.Duration
            return dur <= (params.max_time as nextflow.util.Duration) ? dur : (params.max_time as nextflow.util.Duration)
        } catch (all) { return params.max_time as nextflow.util.Duration }
    } else if (type == 'cpus') {
        try { return Math.min(obj as int, params.max_cpus as int) }
        catch (all) { return params.max_cpus as int }
    }
}

// Default process-level resource settings (can be overridden per-process)
process {
    cpus   = { check_max( 1,      'cpus'   ) }
    memory = { check_max( '4 GB', 'memory' ) }
    time   = { check_max( '1 h',  'time'   ) }
    // No default container — each module sets its own container directive.
    // Do NOT set a global container here; processes that need one declare it themselves.

    // RUN_WF_HUMVAR launches a nested nextflow run inside a Slurm job.
    // The compute node must have nextflow + java available (via module or PATH).
    // No container — uses the node environment directly.
    withName: 'RUN_WF_HUMVAR' {
        container = null
    }
}

// End of file
